# Copy to .env and fill in. `.env` is git-ignored and must never be committed.
# Every key below maps to a field on linkedos.core.config.Settings.

# --- Credentials -------------------------------------------------------------
# Anthropic API key for Claude calls. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# LinkedIn OAuth app. https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# --- Local services ----------------------------------------------------------
# Base URL of a local Ollama server. Default: http://localhost:11434
OLLAMA_BASE_URL=

# --- Storage -----------------------------------------------------------------
# SQLite file. Its parent directory also holds logs/ and backups/.
# Default: data/linkedos.db
DB_PATH=

# --- Operations --------------------------------------------------------------
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL. Default: INFO
LOG_LEVEL=

# Soft cap on LLM spend per calendar month, in USD. Default: 30
MONTHLY_BUDGET_USD=
